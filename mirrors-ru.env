# Профиль зеркал для сетей, где недоступны pypi.org/files.pythonhosted.org, Docker Hub, quay.io,
# CDN pkgs.k8s.io и cdn.registry.k8s.io (проверено на VPS в РФ, 10.2026). Подключение:
#   cp mirrors-ru.env .env      (или дописать строки в существующий .env)
# Комментарии — только отдельными строками: значения читает make.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
K8S_APT_REPO=https://mirrors.aliyun.com/kubernetes-new/core/stable/v1.36/deb/
DOCKERHUB_MIRRORS=https://dockerhub.timeweb.cloud
QUAY_MIRRORS=https://quay.dockerproxy.net
K8S_REGISTRY_MIRRORS=https://k8s.dockerproxy.net
OCI_DOCKERHUB_MIRROR=dockerhub.timeweb.cloud
# образы Calico (calico/node и др.) — из Docker Hub через DOCKERHUB_MIRRORS вместо quay.io
CALICO_REGISTRY=docker.io/
# запасной источник Helm-чартов (OCI в ghcr.io), если GitHub Releases недоступны
GHCR_MIRROR=ghcr.dockerproxy.net
